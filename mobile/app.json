
{
  "expo": {
    "name": "TALKZY",
    "slug": "talkzy",
    "version": "1.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "talkzy",
    "newArchEnabled": true,
    "android": {
      "package": "com.talkzy.app",
      "versionCode": 5,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TALKZY needs access to your photos so you can upload a profile picture.",
          "cameraPermission": "TALKZY needs camera access so you can take a profile picture.",
          "microphonePermission": false
        }
      ]
    ]
  }
}

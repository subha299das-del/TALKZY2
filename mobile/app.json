{
  "expo": {
    "name": "TALKZY",
    "slug": "talkzy",
    "version": "1.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "talkzy",
    "newArchEnabled": true,
    "icon": "./assets/talkzy-icon.png",
    "android": {
      "package": "com.talkzy.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/talkzy-icon.png",
        "backgroundColor": "#080B18"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea810d6f-e7af-40f0-9674-fd7f21c6a2b5"
      }
    }
  }
}

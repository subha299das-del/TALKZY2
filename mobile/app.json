{
  "expo": {
    "name": "TALKZY",
    "slug": "talkzy",
    "version": "1.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "talkzy",
    "newArchEnabled": true,
    "icon": "./assets/talkzy-icon.png",
    "android": {
      "package": "com.talkzy.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/talkzy-icon.png",
        "backgroundColor": "#080B18"
      }
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ]
    ]
  }
}
